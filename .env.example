# HaloKYC Docs - Environment Variables
# Copy to .env.local for local development. Never commit secrets.

# Production site origin. REQUIRED for production builds.
# Must be a valid HTTPS URL (e.g., https://docs.halokyc.com).
# Fails the build if missing or pointing to localhost in production.
NEXT_PUBLIC_SITE_URL=https://docs.halokyc.com